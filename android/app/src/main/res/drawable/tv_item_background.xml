<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="9dp"/>
            <solid android:color="#CC111E2F"/>
            <stroke android:width="3dp" android:color="#47E6A5"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="9dp"/>
            <solid android:color="#CC111E2F"/>
            <stroke android:width="3dp" android:color="#FFE500"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="9dp"/>
            <solid android:color="#A9111E2F"/>
            <stroke android:width="1dp" android:color="#556A8098"/>
        </shape>
    </item>
</selector>
