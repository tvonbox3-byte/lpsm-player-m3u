<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/activation_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.58"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/logo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.10"
                android:maxLines="1"
                android:text="LPSM PLAYER"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ATIVAÇÃO COMPLETA -->
        <LinearLayout
            android:id="@+id/activation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Seu dispositivo ainda não está ativado"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Cadastre o endereço abaixo no painel de controle"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/mac_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENDEREÇO MAC"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/deviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FFE500"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <EditText
                    android:id="@+id/server"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:alpha="0"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/code"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:alpha="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/activateButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:backgroundTint="#7656A8"
                        android:text="ATUALIZAR"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:backgroundTint="#7656A8"
                        android:text="CANCELAR"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/panel_badge"
                    android:gravity="center"
                    android:text="LPSM\nCONTROL"
                    android:textColor="#08111E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="PAINEL DE ATIVAÇÃO"
                    android:textColor="#FFE500"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/homeWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="BEM-VINDO AO LPSM"
                android:textColor="@color/text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escolha o que deseja assistir"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <Button
                    android:id="@+id/homeLive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:maxHeight="120dp"
                    android:minHeight="72dp"
                    android:text="TV AO VIVO"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/homeVod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:maxHeight="120dp"
                    android:minHeight="72dp"
                    android:text="FILMES"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/homeSeries"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:maxHeight="120dp"
                    android:minHeight="72dp"
                    android:text="SÉRIES"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- CONTEÚDO -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="10sp" />


            <!-- BUSCA + FILTROS + PRÉVIA SUPERIOR -->
            <LinearLayout
                android:id="@+id/topMediaRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/searchAndFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/search"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/tv_search_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="Buscar canais, filmes e séries"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="5dp"
                        android:fillViewport="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/filters"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/all"
                                android:layout_width="88dp"
                                android:layout_height="44dp"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:text="TUDO"
                                android:textColor="@color/text"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/live"
                                android:layout_width="92dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="4dp"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:text="AO VIVO"
                                android:textColor="@color/text"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/vod"
                                android:layout_width="92dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="4dp"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:text="FILMES"
                                android:textColor="@color/text"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/series"
                                android:layout_width="92dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="4dp"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:text="SÉRIES"
                                android:textColor="@color/text"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/favorites"
                                android:layout_width="110dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="4dp"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:text="FAVORITOS"
                                android:textColor="@color/text"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>


                <!-- FILMES / SÉRIES -->
                <FrameLayout
                    android:id="@+id/previewTopHost"
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- NAVEGAÇÃO PRINCIPAL -->
            <LinearLayout
                android:id="@+id/browserArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- CATEGORIAS / TEMPORADAS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryList"
                    android:layout_width="145dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:paddingEnd="5dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#668AA0B8" />


                <!-- CANAIS / FILMES / SÉRIES / EPISÓDIOS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp" />


                <!-- PRÉVIA AO VIVO -->
                <FrameLayout
                    android:id="@+id/previewSideHost"
                    android:layout_width="205dp"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/previewPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="6dp">

                        <!-- PRECISA SER O PRIMEIRO FILHO -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:background="#E8000000">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="LPSM"
                                android:textColor="#556A8098"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/previewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Selecione um conteúdo"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/previewGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/previewWatch"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="2dp"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:text="ASSISTIR"
                            android:textColor="@color/text"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ATIVAÇÃO SIMPLES -->
    <LinearLayout
        android:id="@+id/activationSimple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2070C14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/simpleLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="LPSM"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="MAC PARA ATIVAÇÃO"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/simpleDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFE500"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ERRO -->
    <LinearLayout
        android:id="@+id/failureState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/failureBanner"
            android:layout_width="180dp"
            android:layout_height="130dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/failureClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/failurePlaylist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE500"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/failureMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:text="A lista está temporariamente indisponível. Corrija a URL no painel e tente novamente."
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#7656A8"
                android:text="TENTAR NOVAMENTE"
                android:textColor="@color/text"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- CARREGAMENTO -->
    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="54dp"
            android:layout_height="54dp" />

        <TextView
            android:id="@+id/loadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Carregando sua lista..."
            android:textColor="@color/text"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
