<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/activation_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.58"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/logo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:text="LPSM PLAYER"
                android:textColor="@color/accent"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ATIVAÇÃO COMPLETA -->
        <LinearLayout
            android:id="@+id/activation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Seu dispositivo ainda não está ativado"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Cadastre o endereço abaixo no painel de controle"
                    android:textColor="@color/text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Suporte com seu revendedor"
                    android:textColor="#FFE500"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/mac_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENDEREÇO MAC"
                        android:textColor="@color/text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/deviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#FFE500"
                        android:textSize="35sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/server"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:alpha="0"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/code"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:alpha="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/activateButton"
                        android:layout_width="220dp"
                        android:layout_height="58dp"
                        android:backgroundTint="#7656A8"
                        android:text="ATUALIZAR"
                        android:textColor="@color/text"
                        android:textSize="17sp" />

                    <Space
                        android:layout_width="28dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="220dp"
                        android:layout_height="58dp"
                        android:backgroundTint="#7656A8"
                        android:text="CANCELAR"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:background="@drawable/panel_badge"
                    android:gravity="center"
                    android:text="LPSM\nCONTROL"
                    android:textColor="#08111E"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="PAINEL DE ATIVAÇÃO"
                    android:textColor="#FFE500"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="https://lpsm-player-backend.onrender.com"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/homeWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEM-VINDO AO LPSM"
                android:textColor="@color/text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Escolha o que deseja assistir"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/homeLive"
                    android:layout_width="230dp"
                    android:layout_height="120dp"
                    android:layout_margin="12dp"
                    android:text="TV AO VIVO"
                    android:textColor="@color/text"
                    android:textSize="21sp" />

                <Button
                    android:id="@+id/homeVod"
                    android:layout_width="230dp"
                    android:layout_height="120dp"
                    android:layout_margin="12dp"
                    android:text="FILMES"
                    android:textColor="@color/text"
                    android:textSize="21sp" />

                <Button
                    android:id="@+id/homeSeries"
                    android:layout_width="230dp"
                    android:layout_height="120dp"
                    android:layout_margin="12dp"
                    android:text="SÉRIES"
                    android:textColor="@color/text"
                    android:textSize="21sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTEÚDO PRINCIPAL -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- BUSCA -->
            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_search_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="Buscar canais, filmes e séries"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="17sp" />

            <!-- ABAS -->
            <LinearLayout
                android:id="@+id/filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/all"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:text="TUDO"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/live"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:text="AO VIVO"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/vod"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:text="FILMES"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/series"
                    android:layout_width="128dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:text="SÉRIES"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/favorites"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:text="FAVORITOS"
                    android:textColor="@color/text" />
            </LinearLayout>

            <!-- NAVEGADOR -->
            <LinearLayout
                android:id="@+id/browserArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- CATEGORIAS / TEMPORADAS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryList"
                    android:layout_width="255dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:paddingEnd="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#668AA0B8" />

                <!-- CAPAS / CANAIS / EPISÓDIOS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp" />

                <!-- PREVIEW COMPACTO À DIREITA -->
                <LinearLayout
                    android:id="@+id/previewPanel"
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <!-- IMPORTANTE: este FrameLayout continua sendo o PRIMEIRO filho -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="197dp"
                        android:background="#E8000000">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="LPSM"
                            android:textColor="#556A8098"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/previewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Selecione um conteúdo"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/previewGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/previewWatch"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="4dp"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:text="ASSISTIR"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ATIVAÇÃO SIMPLES -->
    <LinearLayout
        android:id="@+id/activationSimple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2070C14"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/simpleLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="LPSM"
            android:textColor="@color/accent"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="MAC PARA ATIVAÇÃO"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/simpleDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFE500"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ERRO -->
    <LinearLayout
        android:id="@+id/failureState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="42dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/failureBanner"
            android:layout_width="280dp"
            android:layout_height="180dp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/failureClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/failurePlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFE500"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/failureMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="A lista está temporariamente indisponível. Corrija a URL no painel e tente novamente."
            android:textColor="@color/text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#7656A8"
            android:text="TENTAR NOVAMENTE"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- CARREGAMENTO -->
    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <TextView
            android:id="@+id/loadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Carregando sua lista..."
            android:textColor="@color/text"
            android:textSize="18sp" />
    </LinearLayout>

</FrameLayout>
