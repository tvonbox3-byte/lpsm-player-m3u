<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080F">

    <LinearLayout
        android:id="@+id/youtubePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#101A2B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/youtubeStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUTUBE"
                android:textColor="#FFE000"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button android:id="@+id/youtubeHome" android:layout_width="110dp" android:layout_height="48dp" android:focusable="true" android:text="INÍCIO" />
            <Button android:id="@+id/youtubeBack" android:layout_width="110dp" android:layout_height="48dp" android:focusable="true" android:text="VOLTAR" />
            <Button android:id="@+id/youtubeReload" android:layout_width="130dp" android:layout_height="48dp" android:focusable="true" android:text="RECARREGAR" />
            <Button android:id="@+id/youtubeClose" android:layout_width="90dp" android:layout_height="48dp" android:focusable="true" android:text="SAIR" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/youtubeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100" />

        <WebView
            android:id="@+id/youtubeWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/youtubeFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
