<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/youtubeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUTUBE PREMIUM"
        android:textColor="#FFE000"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="Escolha um aplicativo instalado. O acesso Premium depende da conta usada."
        android:textColor="#DCE6F2"
        android:textSize="17sp" />

    <Button
        android:id="@+id/youtubeOpen"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:focusable="true"
        android:text="ABRIR YOUTUBE"
        android:textSize="18sp" />

    <Button
        android:id="@+id/smartTubeOpen"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="ABRIR SMARTTUBE"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="SmartTube e opcional e sera baixado da publicacao oficial do projeto."
        android:textColor="#93A4B8"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/youtubeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="320dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:visibility="gone" />

    <Button
        android:id="@+id/youtubeClose"
        android:layout_width="220dp"
        android:layout_height="58dp"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:text="VOLTAR"
        android:textSize="17sp" />

</LinearLayout>
