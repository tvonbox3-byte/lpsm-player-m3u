<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp"
    android:layout_marginBottom="3dp" android:background="@drawable/category_background"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingHorizontal="18dp">
    <TextView android:id="@+id/categoryName" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end"
        android:maxLines="1" android:textColor="@color/text" android:textSize="18sp"/>
    <TextView android:id="@+id/categoryCount" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="17sp"/>
</LinearLayout>
