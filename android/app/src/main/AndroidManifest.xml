<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!--
        Permite que o LPSM solicite ao Android
        a instalação do APK de atualização.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />


    <!--
        Compatibilidade:
        celular, tablet, TV Box e Android TV.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />


    <application
        android:theme="@style/Theme.LPSM"
        android:label="LPSM"
        android:networkSecurityConfig="@xml/network_security_config"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/app_icon_lpsm"
        android:roundIcon="@drawable/app_icon_lpsm"
        android:resizeableActivity="true"
        android:supportsRtl="true">


        <!--
            =================================================
            FILE PROVIDER
            =================================================

            Entrega o APK baixado para o
            instalador do Android com segurança.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />

        </provider>


        <!--
            =================================================
            PLAYER DE VÍDEO
            =================================================
        -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />


        <!--
            =================================================
            TELA PRINCIPAL DO LPSM
            =================================================

            Agora ela NÃO abre diretamente.

            UpdateActivity verifica atualização
            e depois abre MainActivity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />


        <!--
            =================================================
            ATUALIZADOR
            =================================================

            Esta passa a ser a PRIMEIRA tela
            executada quando abrir o LPSM.

            Fluxo:

            Abrir LPSM
                 ↓
            UpdateActivity
                 ↓
            verificar update.json
                 ↓
            sem atualização → MainActivity

            com atualização → aviso para atualizar
        -->
        <activity
            android:name=".UpdateActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">


            <!-- CELULAR / TABLET / TV BOX -->
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>


            <!-- ANDROID TV -->
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LEANBACK_LAUNCHER" />

            </intent-filter>

        </activity>


    </application>

</manifest>
